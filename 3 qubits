from qiskit import QuantumCircuit, transpile, QuantumRegister, ClassicalRegister
from qiskit_aer import AerSimulator
import numpy as np
from qiskit.visualization import plot_histogram
import matplotlib.pyplot as plt

# 1. Definir el oráculo (generalizado)
def oracle(qc, secret_string, qr):
    """Marca el estado objetivo especificado por secret_string."""
    n = len(secret_string)
    qc.barrier(qr)

    # Aplicar X a los qubits que están en 0
    for i, bit in enumerate(secret_string):
        if bit == '0':
            qc.x(qr[i])

    # Aplicar compuerta Z controlada (convirtiendo en CCZ)
    qc.h(qr[n - 1])
    qc.mcx(qr[:-1], qr[n - 1])
    qc.h(qr[n - 1])

    # Revertir las X
    for i, bit in enumerate(secret_string):
        if bit == '0':
            qc.x(qr[i])

    qc.barrier(qr)

# 2. Difusor (inversión sobre la media)
def diffuser(qc, n, qr):
    qc.barrier(qr)
    qc.h(qr)
    qc.x(qr)
    qc.h(qr[n - 1])
    qc.mcx(qr[:-1], qr[n - 1])
    qc.h(qr[n - 1])
    qc.x(qr)
    qc.h(qr)
    qc.barrier(qr)

# === CONFIGURACIÓN PRINCIPAL ===

# El usuario define el secreto como lo ve (sin invertir)
user_secret = '110'

# Qiskit usa orden inverso, así que invertimos para los qubits
secret_string = user_secret[::-1]

n = len(secret_string)
qr = QuantumRegister(n, name='q')
cr = ClassicalRegister(n, name='c')
qc = QuantumCircuit(qr, cr, name='grover')

# Inicialización
qc.h(qr)
qc.barrier(qr)

# Iteraciones de Grover (≈ pi/4 * sqrt(N))
iterations = int(np.floor(np.pi / 4 * np.sqrt(2**n)))
print(f"Número de iteraciones: {iterations}")

for _ in range(iterations):
    oracle(qc, secret_string, qr)
    diffuser(qc, n, qr)

# Medición
qc.measure(qr, cr)

# Simulación
simulator = AerSimulator()
compiled_circuit = transpile(qc, simulator)
job = simulator.run(compiled_circuit, shots=8192)
result = job.result()
counts = result.get_counts()

# Mostrar resultados
print("\nResultados del conteo:", counts)
plot_histogram(counts, title=f"Grover: objetivo '{user_secret}'")
plt.show()
